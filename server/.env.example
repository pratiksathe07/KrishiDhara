# Server Environment Variables

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/krishidhara?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secure_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Verification Token (short-lived JWT after OTP success, before final register)
VERIFICATION_TOKEN_SECRET=another_super_secure_secret_min_32_chars
VERIFICATION_TOKEN_EXPIRES_IN=10m

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=KrishiDhara <noreply@yourdomain.com>

# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
